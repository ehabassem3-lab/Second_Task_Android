<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#011627"
    android:padding="20dp"
    >

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="right|bottom"
        android:minLines="5"
        android:text=" =12.454    "
        android:textColor="@color/white"
        android:textSize="60dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/firstRow"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintTop_toBottomOf="@+id/text"
        android:orientation="horizontal"
         android:weightSum="4"
        android:divider="@drawable/lay"
        android:showDividers="middle"
        android:gravity="center"



        >

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/button1"
            android:onClick="RemoveAll"
            android:text="Ac"
            android:textSize="30dp"

            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/button1"
            android:onClick="Remove"
            android:text="⌦"
            android:textSize="30dp"


            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/button3"
            android:onClick="OneOperationClick"
            android:text="/"
            android:textSize="30dp"

            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/onClick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/button3"
            android:onClick="OneOperationClick"

            android:text="*"
            android:textSize="30dp" />



    </LinearLayout>
    <LinearLayout
        android:id="@+id/colums3"
        android:layout_width="280dp"
        android:layout_height="300dp"

        app:layout_constraintTop_toBottomOf="@id/firstRow"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="10dp"
        android:weightSum="3"
       >
    <LinearLayout
        android:layout_weight="1"
        android:id="@+id/firstC"
        android:layout_width="100dp"
        android:layout_height="250dp"
        app:layout_constraintTop_toBottomOf="@+id/firstRow"
        app:layout_constraintStart_toStartOf="@+id/firstRow"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="10dp"

        android:weightSum="3"
        android:orientation="vertical"
        android:divider="@drawable/lay2"
        android:showDividers="middle"

        >

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/b7"
            android:layout_width="70dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/button3"
            android:onClick="OneDigitClick"
            android:text="7"
            android:textSize="30dp"

            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/b4"
            android:layout_width="70dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/button3"
            android:onClick="OneDigitClick"
            android:text="4"
            android:textSize="30dp"

            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/b1"
            android:layout_width="70dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/button3"
            android:onClick="OneDigitClick"
            android:text="1"
            android:textSize="30dp"

            android:textStyle="bold" />







    </LinearLayout>
        <LinearLayout
            android:layout_weight="1"
            android:id="@+id/secondC"
            android:layout_width="100dp"
            android:layout_height="250dp"
            app:layout_constraintTop_toBottomOf="@+id/firstRow"
            app:layout_constraintStart_toStartOf="@+id/firstRow"
            android:layout_marginTop="15dp"
            android:layout_marginLeft="10dp"

            android:weightSum="3"
            android:orientation="vertical"
            android:divider="@drawable/lay2"
            android:showDividers="middle"

            >

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/b8"
                android:layout_width="70dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/button3"
                android:onClick="OneDigitClick"
                android:text="8"
                android:textSize="30dp"

                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/b5"
                android:layout_width="70dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/button3"
                android:onClick="OneDigitClick"
                android:text="5"
                android:textSize="30dp"

                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/b2"
                android:layout_width="70dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/button3"
                android:onClick="OneDigitClick"
                android:text="2"
                android:textSize="30dp"

                android:textStyle="bold" />







        </LinearLayout>
        <LinearLayout
            android:layout_weight="1"
            android:id="@+id/thirdC"
            android:layout_width="100dp"
            android:layout_height="250dp"
            app:layout_constraintTop_toBottomOf="@+id/firstRow"
            app:layout_constraintStart_toStartOf="@+id/firstRow"
            android:layout_marginTop="15dp"
            android:layout_marginLeft="10dp"

            android:weightSum="3"
            android:orientation="vertical"
            android:divider="@drawable/lay2"
            android:showDividers="middle"

            >

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/b9"
                android:layout_width="70dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/button3"
                android:onClick="OneDigitClick"
                android:text="9"
                android:textSize="30dp"

                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/b6"
                android:layout_width="70dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/button3"
                android:onClick="OneDigitClick"
                android:text="6"
                android:textSize="30dp"

                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/b3"
                android:layout_width="70dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/button3"
                android:onClick="OneDigitClick"
                android:text="3"
                android:textSize="30dp"

                android:textStyle="bold" />







        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="70dp"
        android:layout_height="350dp"
        android:id="@+id/lastC"

        app:layout_constraintStart_toEndOf="@id/colums3"
        app:layout_constraintTop_toBottomOf="@id/firstRow"
        android:orientation="vertical"
        android:layout_marginLeft="18dp"
        android:weightSum="8"
        android:layout_marginTop="30dp"
        android:divider="@drawable/lay2"
        android:showDividers="middle"
        >

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:background="@drawable/button2"
            android:onClick="OneOperationClick"
            android:text="-"
            android:textSize="30dp"

            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_add"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:background="@drawable/button2"
            android:onClick="OneOperationClick"
            android:text="+"
            android:textSize="30dp"

            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_equals"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:background="@drawable/button2"
            android:text="="
            android:textSize="30dp"

            android:textStyle="bold" />


    </LinearLayout>
        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="70dp"
            app:layout_constraintStart_toStartOf="@+id/firstRow"
            android:weightSum="3"
            app:layout_constraintTop_toBottomOf="@id/colums3"

            android:divider="@drawable/lay"
            android:showDividers="middle"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="5dp"
            >

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button3"
                android:onClick="OneDigitClick"
                android:text="0"
                android:textSize="30dp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/button3"
                android:onClick="OneDigitClick"
                android:text="."
                android:textSize="30dp"
                android:textStyle="bold" />


        </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>